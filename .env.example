# Copy to .env and adjust. Everything is optional: demo mode needs no LLM.

# Simcore source: repository and commit, tag or branch (default: the fork with the
# agent life cycle). Leave commented out to use the version pinned in docker-compose.yml.
# SIMCORE_REPO=https://github.com/dgarcoe/simcore
# SIMCORE_REF=5a3a6c5b32c560046a4a10de058e500065971e76

# Host ports
UI_PORT=8080
SIMCORE_PORT=8420

# Cloud LLMs (used when a scenario's llm.model points to them and demo mode is off)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local LLM. scripts/simcore-up.sh picks a model for your hardware; set one here
# (or pass --model) to force it. Plain `docker compose --profile ollama up`
# uses qwen2.5:7b when this is empty.
OLLAMA_MODEL=
# Also publish the model under this name (built-in scenarios ask for qwen2.5:7b).
OLLAMA_ALIAS=

# Games with players (work, workshops…): with a password only dungeon masters can use Simcore and
# see the simulation; players join their game through its link (#/jugar/<code>) and only see the
# briefing, the other players' names, their own agent and what the DM publishes.
# Use it inside your network or behind HTTPS.
# SIMCORE_DM_PASSWORD=
