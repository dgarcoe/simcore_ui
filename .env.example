# Copy to .env and adjust. Everything is optional: demo mode needs no LLM.

# Simcore version (commit, tag or branch of github.com/elisonfrank/simcore)
SIMCORE_REF=896875746c8ba251da4c7b8ea8f4efa3cddb5bc4

# Host ports
UI_PORT=8080
SIMCORE_PORT=8420

# Cloud LLMs (used when a scenario's llm.model points to them and demo mode is off)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local LLM with `docker compose --profile ollama up`
OLLAMA_MODEL=qwen2.5:7b
